{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konsora",
  "version": "0.1.0",
  "identifier": "app.konsora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Konsora",
        "width": 1100,
        "height": 820,
        "minWidth": 640,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "workspace-folder",
          "windows": [
            "main"
          ],
          "permissions": [
            "dialog:allow-open"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/128x128.png"
    ],
    "resources": {
      "resources/backend/": "backend/"
    },
    "targets": [
      "deb"
    ],
    "shortDescription": "Tareas de proyecto y prompts locales",
    "category": "Development",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libssl3t64"
        ]
      }
    }
  }
}
