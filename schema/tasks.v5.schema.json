{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsora.local/schema/tasks.v5.json",
  "title": "Konsora tasks (konsora/5)",
  "description": "Structure of .konsora/tasks.json. Semantic rules (ids vs groups, seq, deps, cycles) are checked by Konsora, not by this schema. See docs/esquema-tareas.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "konsora/5"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "templates": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "desc": {
                "type": "string",
                "maxLength": 32768
              },
              "acceptance": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "patternProperties": {
                    "^x-": {}
                  }
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
                }
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        }
      }
    },
    "seq": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,5}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "archived": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "todo",
              "doing",
              "done"
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}$"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
            }
          },
          "rank": {
            "type": "string",
            "pattern": "^[0-9a-z]+$"
          },
          "desc": {
            "type": "string",
            "maxLength": 32768
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ac\\d+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "created": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
              },
              "by": {
                "type": "string",
                "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
              }
            },
            "required": [
              "at",
              "by"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          },
          "started": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
              },
              "by": {
                "type": "string",
                "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
              }
            },
            "required": [
              "at",
              "by"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^n\\d+$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                },
                "by": {
                  "type": "string",
                  "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "note",
                    "question",
                    "answer",
                    "feedback",
                    "summary"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "options": {
                  "minItems": 2,
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "edited": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                }
              },
              "required": [
                "id",
                "at",
                "by",
                "kind",
                "text"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                },
                "by": {
                  "type": "string",
                  "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "promote",
                    "demote",
                    "start",
                    "pause",
                    "finish",
                    "reopen",
                    "edit"
                  ]
                },
                "fields": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "title",
                      "desc",
                      "acceptance",
                      "labels",
                      "group",
                      "rank",
                      "difficulty",
                      "deps"
                    ]
                  }
                }
              },
              "required": [
                "at",
                "by",
                "type"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "state",
          "group",
          "rank",
          "created",
          "updated_at"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        }
      }
    },
    "deleted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
          },
          "by": {
            "type": "string",
            "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
          }
        },
        "required": [
          "id",
          "title",
          "at",
          "by"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        }
      }
    }
  },
  "required": [
    "schema",
    "project",
    "groups",
    "seq",
    "tasks"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  }
}
