{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsora.local/schema/tasks.v2.json",
  "title": "Konsora tasks (konsora/2)",
  "description": "Structure of .konsora/tasks.json. Semantic rules (ids vs groups, seq, deps, cycles) are checked by Konsora, not by this schema. See docs/esquema-tareas.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "konsora/2"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "defaults": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "claude",
                "codex"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "permissions": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "recommended": {
          "type": "object",
          "properties": {
            "low": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "permissions": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            },
            "medium": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "permissions": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            },
            "high": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "codex"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                "permissions": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "setup": {
          "type": "object",
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false,
          "patternProperties": {
            "^x-": {}
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "timeout_s": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              }
            },
            "required": [
              "id",
              "run"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          }
        },
        "check_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "name",
        "base_branch"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x-": {}
      }
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        }
      }
    },
    "seq": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{0,5}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "todo",
              "doing",
              "review",
              "done"
            ]
          },
          "group": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,5}$"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]{0,5}-\\d{2,}$"
            }
          },
          "rank": {
            "type": "string",
            "pattern": "^[0-9a-z]+$"
          },
          "desc": {
            "type": "string",
            "maxLength": 32768
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ac\\d+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "check": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "agent": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "permissions": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          },
          "yolo": {
            "type": "boolean",
            "const": true
          },
          "created": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
              },
              "by": {
                "type": "string",
                "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
              }
            },
            "required": [
              "at",
              "by"
            ],
            "additionalProperties": false,
            "patternProperties": {
              "^x-": {}
            }
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^n\\d+$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                },
                "by": {
                  "type": "string",
                  "pattern": "^(human|konsora|agent:[a-z0-9][a-z0-9._-]{0,39})$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "note",
                    "question",
                    "answer",
                    "feedback",
                    "summary"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "run": {
                  "type": "string",
                  "pattern": "^r-[0-9A-Z]{6,26}$"
                },
                "edited": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z))$"
                }
              },
              "required": [
                "id",
                "at",
                "by",
                "kind",
                "text"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^x-": {}
              }
            }
          }
        },
        "required": [
          "id",
          "title",
          "state",
          "group",
          "rank",
          "created",
          "updated_at"
        ],
        "additionalProperties": false,
        "patternProperties": {
          "^x-": {}
        }
      }
    }
  },
  "required": [
    "schema",
    "project",
    "groups",
    "seq",
    "tasks"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  }
}
