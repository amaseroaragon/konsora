{
  "$defs": {
    "PortableActivity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 1,
          "title": "Id",
          "type": "integer"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "event": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "actor": {
          "enum": [
            "user",
            "supervisor",
            "external"
          ],
          "title": "Actor",
          "type": "string"
        },
        "detail": {
          "default": "",
          "maxLength": 4000,
          "title": "Detail",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task_id",
        "task_version",
        "event",
        "actor",
        "created_at"
      ],
      "title": "PortableActivity",
      "type": "object"
    },
    "PortableAttempt": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "task_snapshot": {
          "$ref": "#/$defs/PortableTask"
        },
        "connector": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Connector",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "result": {
          "default": "",
          "maxLength": 64000,
          "title": "Result",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "required": [
        "id",
        "task_id",
        "task_version",
        "task_snapshot",
        "connector",
        "status",
        "started_at"
      ],
      "title": "PortableAttempt",
      "type": "object"
    },
    "PortableReview": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Task Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "fingerprint",
        "accepted_at",
        "signature"
      ],
      "title": "PortableReview",
      "type": "object"
    },
    "PortableTask": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 16000,
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "default": "",
          "maxLength": 16000,
          "title": "Acceptance Criteria",
          "type": "string"
        },
        "sort_order": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Sort Order",
          "type": "integer"
        },
        "status": {
          "default": "pending",
          "enum": [
            "proposal",
            "pending",
            "in_progress",
            "in_review",
            "done"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Dependencies",
          "type": "array"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "PortableTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/PortableTask"
      },
      "maxItems": 2000,
      "title": "Tasks",
      "type": "array"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/PortableAttempt"
      },
      "maxItems": 20000,
      "title": "Attempts",
      "type": "array"
    },
    "activity": {
      "items": {
        "$ref": "#/$defs/PortableActivity"
      },
      "maxItems": 50000,
      "title": "Activity",
      "type": "array"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/PortableReview"
      },
      "maxItems": 10000,
      "title": "Reviews",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tasks"
  ],
  "title": "TaskDocument",
  "type": "object"
}
