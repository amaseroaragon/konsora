# Opcional: Vite lee este archivo al copiarlo a .env en la raíz.
# Solo contiene configuración pública; nunca añadir credenciales VITE_*.
VITE_API_URL=http://127.0.0.1:8000
# Backend: se configura en la terminal, no mediante este archivo de Vite.
# export KONSORA_DATABASE_PATH=.local/konsora.sqlite3
# Codex: sesión de ChatGPT gestionada por el CLI, nunca tokens en este archivo.
# Opcionales del backend, exportados en su terminal:
# KONSORA_CODEX_BIN: ruta al ejecutable oficial si no está en PATH.
# KONSORA_CODEX_MODEL: ID de un modelo disponible para la suscripción.
