{
  "name": "konsora",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "test": "vitest run",
    "schema": "node packages/core/scripts/gen-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
