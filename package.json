{
  "name": "konsora",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/desktop"],
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "dev:api": ".venv/bin/python -m uvicorn konsora_api.main:app --app-dir services/api --host 127.0.0.1 --port 8000 --reload --reload-dir services/api",
    "dev:desktop": "bash scripts/desktop.sh dev",
    "dev:web": "npm run dev --workspace @konsora/desktop",
    "typecheck": "npm run typecheck --workspace @konsora/desktop",
    "build": "npm run build --workspace @konsora/desktop",
    "build:desktop": "bash scripts/desktop.sh build --no-bundle",
    "test:api": ".venv/bin/python -m pytest -c services/api/pyproject.toml services/api/tests",
    "check": "npm run typecheck && npm run build && npm run test:api"
  }
}
